# ============================================================
# RIME — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to source control.
# ============================================================

# --- Rime TTS (required) ---
# Obtain from https://rime.ai — pin exact values from the live catalog at submission time.
RIME_API_KEY=your_rime_api_key_here
RIME_MODEL_ID=mist
RIME_SPEAKER=lagoon
RIME_LANGUAGE=en-US
RIME_AUDIO_FORMAT=pcm_16000
RIME_ENDPOINT=wss://users.rime.ai/v1/rime-tts
RIME_HTTP_ENDPOINT=https://users.rime.ai/v1/rime-tts

# --- LLM (local-first; external only via ExternalServiceManager) ---
# Leave OLLAMA_BASE_URL blank to use the bundled offline model stub.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# External LLM fallback (only used if local model cannot handle the request)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Live-data tools ---
WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

TRANSPORT_API_KEY=your_transport_api_key_here
TRANSPORT_BASE_URL=https://api.example-transit.com/v1

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8080
SECRET_KEY=change_me_to_a_random_64_char_string
DATABASE_PATH=./rime.sqlite

# --- STT (local Whisper) ---
# Model size: tiny | base | small | medium | large
WHISPER_MODEL_SIZE=base

# --- Speaker identification ---
SPEAKER_MATCH_CONFIDENT_THRESHOLD=0.80
SPEAKER_MATCH_TENTATIVE_THRESHOLD=0.60

# --- Safety ---
EMERGENCY_CONFIDENCE_THRESHOLD=0.85

# --- Feature flags ---
ENABLE_PRIVACY_MODE=true
ENABLE_EMERGENCY_DETECTION=true
ENABLE_PROACTIVE_TASKS=false
LOG_LEVEL=INFO
